POSTGRES_USER=patients
POSTGRES_PASSWORD=patients
POSTGRES_DB=patients
POSTGRES_PORT=5432

# Required in any shared environment. Must be at least 32 characters.
JWT_SECRET=local-docker-jwt-secret-change-me-32chars
JWT_EXPIRES_IN=1h

# Browser origin allowed to call the API.
CORS_ORIGIN=http://localhost:3000

# URL baked into the frontend at image build time. The browser calls this directly.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Simulated latency and occasional 503s. Set to false for a quiet demo.
CHAOS_ENABLED=true
CHAOS_FAILURE_RATE=0.1
CHAOS_MAX_LATENCY_MS=1200

SEED_ADMIN_PASSWORD=Admin123!
SEED_USER_PASSWORD=User123!
