NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://patients:patients@localhost:5432/patients?schema=public

# Use a long random string in any shared environment.
JWT_SECRET=change-me-to-a-long-random-string
# Use 2m to demo token expiry handling.
JWT_EXPIRES_IN=1h

CORS_ORIGIN=http://localhost:3000

# Simulated flaky dependency: random latency and occasional 503s.
CHAOS_ENABLED=true
CHAOS_FAILURE_RATE=0.1
CHAOS_MAX_LATENCY_MS=1200

SEED_ADMIN_PASSWORD=Admin123!
SEED_USER_PASSWORD=User123!
